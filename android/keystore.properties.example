# Copy to keystore.properties (git-ignored) and fill in your upload key details.
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore dyrecto-upload.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep dyrecto-upload.jks OUT of git and backed up securely.
storeFile=dyrecto-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
